{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@frontend/*": [
        "./src/frontend/*"
      ],
      "@backend/config/*": [
        "./src/backend/00_config/*"
      ],
      "@backend/types": [
        "./src/backend/01_types/index.ts"
      ],
      "@backend/models": [
        "./src/backend/02_models/index.ts"
      ],
      "@backend/services/*": [
        "./src/backend/03_services/*"
      ],
      "@backend/queries/*": [
        "./src/backend/04_queries/*"
      ],
      "@backend/actions/*": [
        "./src/backend/05_actions/*"
      ],
      "@backend/utils": [
        "./src/backend/06_utils/index.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
