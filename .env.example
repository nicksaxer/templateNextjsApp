# The showcase runs with no environment variables or external services.
# Optional Docker Compose / Portainer host port. The container listens on 3000.
APP_PORT=3000

# Optional database integration; use a dedicated development database.
MONGODB_URI=mongodb://127.0.0.1:27017/template-nextjs-app

# Optional SMTP integration. The showcase only previews mail; it never sends it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM="Your App <no-reply@example.com>"
